abi <abi/4.0>,
#include <tunables/global>

profile wme-platform-agent flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  file,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  signal (receive) peer=unconfined,
  signal (receive) peer=wme-project-supervisor,
  signal (send,receive) peer=wme-platform-agent,
  signal (send,receive) peer="wme-platform-agent//&wme-project-supervisor",
  deny network raw,
  deny network packet,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace,
  deny userns,
  deny /proc/sys/** wklx,
  deny /proc/sysrq-trigger rwklx,
  deny /proc/kcore rwklx,
  deny /proc/keys rwklx,
  deny /proc/timer_list rwklx,
  deny /proc/{latency_stats,timer_stats,sched_debug} rwklx,
  deny /proc/{acpi,asound,scsi}/** rwklx,
  deny /sys/** wklx,
  deny /run/docker.sock rwklx,
  deny /var/run/docker.sock rwklx,
}
