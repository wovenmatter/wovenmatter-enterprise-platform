# Copy outside source control, then replace every example origin and immutable image tag.
WME_CANDIDATE_ROOT=/srv/wovenmatter-enterprise-candidate
WME_PUBLIC_ORIGIN=https://candidate.example.com
WME_PLATFORM_IMAGE=wovenmatter-enterprise:REPLACE_WITH_COMMIT
WME_SUPERVISOR_IMAGE=wovenmatter-enterprise-supervisor:REPLACE_WITH_COMMIT
WME_RUNNER_IMAGE=wovenmatter-enterprise-runner:REPLACE_WITH_COMMIT
WME_INFERENCE_IMAGE=wovenmatter-enterprise-inference:acdace936fa7df2905500c7f5e0a97d683138dea
# Match these to a dedicated, unused RFC1918 /24 and its reviewed firewall policy.
# Reserve .1 for the host bridge and .2 for the API; proxies use .3 through .254.
WME_INFERENCE_SUBNET=172.31.251.0/24
WME_INFERENCE_API_ADDRESS=172.31.251.2
WME_INFERENCE_NETWORK=wme-inference
WME_INFERENCE_BRIDGE=br-wmeinference
WME_API_CONTAINER=wme-candidate-api
WME_PORTAL_PORT=4180
WME_RUNNER_APPARMOR_PROFILE=wme-platform-agent
# Reserve this pool only after checking host routes and every existing Docker subnet.
# Persistent projects allocate individual /28 networks from it.
WME_ISOLATED_NETWORK_POOL=10.253.0.0/16
# Standalone asset compute rests after this idle period (30–86400 seconds).
WME_ASSET_IDLE_SECONDS=300
WME_MAX_CONCURRENT_RUNS=8
WME_MAX_CONCURRENT_RUNS_PER_ORGANIZATION=4
# Opt-in authenticated agent HTTP/S access; port 4101 is never published.
WME_EGRESS_ENABLED=false
# Additional host public NAT IPs, names to block, and public ingress hostnames
# whose resolved IPs must also be blocked (including reverse-proxy/CDN names).
# Public portal origins are inferred automatically.
WME_EGRESS_DENIED_IPS=
WME_EGRESS_DENIED_HOSTS=
WME_EGRESS_INGRESS_HOSTS=
