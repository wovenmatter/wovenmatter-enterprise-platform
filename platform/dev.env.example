# Local development only. Use Node 24.21.0 and npm 12.2.0 from your PATH.
NODE_ENV=development
WME_HOST=127.0.0.1
WME_PORT=4160
WME_STATE_DIR=./platform/.state/dev
WME_PUBLIC_ORIGIN=http://localhost:5173
WME_INTERNAL_API_ORIGIN=http://127.0.0.1:4160
WME_EGRESS_ENABLED=false
WME_CONTENT_ORIGIN_TEMPLATE=http://{assetId}.localhost:4160
# Mail is disabled by default. Configure a local test SMTP sink explicitly.
# WME_SMTP_HOST=127.0.0.1
# WME_SMTP_PORT=1025
# WME_SMTP_FROM=WovenMatter Enterprise Platform <auth@example.com>
# The mail transport requires TLS; the sink must support STARTTLS.
