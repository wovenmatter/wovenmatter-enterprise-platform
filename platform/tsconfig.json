{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "deploy/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "apps/web", "**/node_modules"]
}
